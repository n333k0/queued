---
// Subscriptions page: every way to work with queued. (Superside's pricing-page structure).
import Layout from '../layouts/Layout.astro';
import BookCall from '../components/BookCall.astro';
import { url } from '../lib/url';
import { srcset } from '../lib/img';
import { plan, links, brand, spotsOpen, capacity } from '../data/site';

// Placeholder checkout links fall back to the membership section until Stripe links exist.
const pay = (href: string) => (href.startsWith('#') ? url('/' + href) : href);
const ways = [
  {
    name: 'Membership',
    best: 'For steady, varied design needs',
    price: plan.priceLabel,
    unit: '/month',
    points: ['One request in progress at a time', '~48h average delivery', 'Pause anytime, unused days banked', 'Unlimited brands, up to 3 users'],
    href: pay(links.checkout),
  },
  {
    name: 'Team',
    best: 'For teams shipping every week',
    price: '$' + (plan.price + plan.lanePrice).toLocaleString('en-US'),
    unit: '/month',
    points: ['Two requests in progress at once', 'A dedicated lead designer', 'Priority queue and Slack channel', 'Monthly design review call'],
    href: pay(links.checkout), // needs its own Stripe link
  },
  {
    name: 'Projects',
    best: 'For one-time, high-stakes launches',
    price: 'Fixed',
    unit: ' price',
    points: ['Fixed scope, fixed timeline', 'Websites from 5 business days', 'Launch campaigns and rebrands', 'Delivered by shipped., our sister product'],
    href: brand.sibling.url + 'start/',
  },
];

const included = [
  'Senior designers and creative direction',
  'Websites built in Framer',
  'Product UI/UX and design systems',
  'Brand, social, ads, decks and email',
  'Short motion for ads and social',
  'Your own request board',
  'Unlimited revisions',
  'Every file is 100% yours',
];

const teams = [
  { title: 'Launch & campaign creative', who: 'For founders and marketing leads', body: 'Landing pages, ad sets and social that ship at the speed of your launch plan.', img: '/placeholder/pricing-social.webp' },
  { title: 'Product & UI', who: 'For product teams', body: 'Flows, dashboards and design systems, handed over in clean Figma your developers will thank you for.', img: '/placeholder/pricing-product.webp' },
  { title: 'Decks & sales collateral', who: 'For sales and fundraising', body: 'Pitch decks, one-pagers and reports that make the room lean in.', img: '/placeholder/pricing-print.webp' },
  { title: 'Brand & motion', who: 'For brands with something to say', body: 'Identities, guidelines and short motion that keep everything you put out consistent.', img: '/placeholder/pricing-video.webp' },
];

const stats = [
  ['~48h', 'average delivery per request'],
  ['3', 'ways to work, one team'],
  [`${capacity.total}`, 'members at a time, max'],
  ['100%', 'of files owned by you'],
];

const faq = [
  { q: 'How do I know which way to work is right for me?', a: 'Most teams start with a Membership. If you regularly have two things in flight, choose Team. If you need one defined thing, like a website, a Project through shipped. is cheaper. Not sure? Book a 15-minute call.' },
  { q: 'Is there a minimum commitment?', a: 'No. Memberships are month to month. Pause when it’s quiet, cancel anytime.' },
  { q: 'What happens if I don’t use the whole month?', a: 'Pause it. Billing runs in 31-day cycles and unused days are banked for when you come back.' },
  { q: 'What if I need more than one request at a time?', a: 'Add a second lane for +$2,995/month (the Team plan). You can drop back to one lane next cycle.' },
  { q: 'What’s included in onboarding?', a: 'Your request board within the hour, a short async kickoff questionnaire and, if you want one, a 15-minute call. Your first request starts the same day.' },
  { q: 'Can I start with a project instead of a subscription?', a: 'Yes. Fixed-scope projects run through shipped., our sister product, at a fixed price and timeline. Plenty of clients start there and join afterwards.' },
  { q: 'How do you use AI?', a: 'Human-led, with AI behind the scenes for research, exploration and production. Senior people make every creative decision.' },
  { q: 'Are there refunds?', a: 'Not loving it after the first week? You get 75% back. After that there are no refunds, and completed work isn’t refunded.' },
];
---

<Layout title={`Subscriptions · ${brand.name} by ${brand.parent}`} overlay>
  <!-- Hero: full-bleed photo behind, big headline bottom-left (Superside-style) -->
  <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden pb-12 pt-[140px] sm:pb-16">
    <img src={url('/placeholder/pricing-hero.webp')} srcset={srcset('/placeholder/pricing-hero.webp')} sizes="100vw" alt="" class="absolute inset-0 -z-20 size-full object-cover object-[70%_18%]" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black via-black/75 to-black/10" aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black via-black/10 to-black/50" aria-hidden="true"></div>
    <div class="wrap w-full">
      <div class="max-w-[1000px]">
        <span class="chip border-white/15 bg-black/40 text-paper/80 backdrop-blur"><span class="dot"></span>{spotsOpen} of {capacity.total} member spots open</span>
        <h1 class="display mt-6 t-hero">Your design backlog, <span class="accent text-spark">cleared every week.</span></h1>
        <p class="mt-6 max-w-xl text-[18px] leading-relaxed text-paper/80 sm:text-[20px]">A small senior team with AI behind the scenes. No hiring, no retainers, no proposals. Start this week, pause when it’s quiet.</p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a href="#ways" class="btn-primary h-14 px-8 text-[16px] btn-wide">See all subscriptions</a>
          <a href="#book" data-call class="btn-ghost h-14 border-white/25 bg-black/30 px-8 text-[16px] backdrop-blur btn-wide">Book a free 15-min call</a>
        </div>
      </div>
      <!-- the three ways, at a glance -->
      <div class="mt-14 grid gap-px overflow-hidden rounded-[24px] border border-white/10 bg-white/10 sm:grid-cols-3">
        {ways.map((w) => (
          <a href="#ways" class="bg-black p-5 transition hover:bg-[#0a0a0a] sm:p-6">
            <p class="label text-paper/50">{w.name}</p>
            <p class="mt-2 text-[24px] font-medium tracking-tight">{w.price}<span class="text-[15px] text-paper/50">{w.unit}</span></p>
            <p class="mt-1 text-[14px] text-paper/60">{w.best}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Three ways -->
  <section id="ways" class="py-24 sm:py-28">
    <div class="wrap">
      <h2 class="display t-h2">One subscription, <span class="accent text-spark">three ways to work.</span></h2>
      <p class="mt-5 max-w-xl text-[17px] text-paper/60">Start flexible, scale to a team, or bring us a one-off project. Every path is the same senior people.</p>

      <div class="mt-12 grid gap-px overflow-hidden rounded-[24px] border border-white/10 bg-white/10 lg:grid-cols-3">
        {ways.map((w) => (
          <article class="flex flex-col bg-black p-8 sm:p-10">
            <div class="flex items-center justify-between">
              <h3 class="text-[28px] font-medium tracking-tight">{w.name}</h3>
            </div>
            <p class="mt-2 text-[15px] text-paper/55">{w.best}</p>
            <p class="mt-8"><span class="display text-[48px]">{w.price}</span><span class="text-[16px] text-paper/50">{w.unit}</span></p>
            <ul class="mt-8 space-y-3 border-t border-white/10 pt-8 text-[15px]">
              {w.points.map((p) => (
                <li class="flex gap-3"><span class="mt-[9px] size-1.5 shrink-0 rounded-full bg-spark"></span>{p}</li>
              ))}
            </ul>
            <a href={w.href} class="mt-auto pt-10">
              <span class="btn-primary h-14 w-full text-[16px]">Join today</span>
            </a>
          </article>
        ))}
      </div>

      <div class="mt-6 grid gap-x-10 gap-y-4 rounded-[24px] border border-white/10 bg-black p-8 sm:grid-cols-2 sm:p-10 lg:grid-cols-4">
        <p class="label text-paper/45 sm:col-span-2 lg:col-span-4">Included in every plan</p>
        {included.map((i) => <p class="flex gap-3 text-[15px] text-paper/85"><span class="text-spark">✓</span>{i}</p>)}
      </div>
    </div>
  </section>

  <!-- Teams -->
  <section class="border-t border-white/10 py-24 sm:py-28">
    <div class="wrap">
      <h2 class="display t-h2">A team built around <span class="accent text-spark">your biggest needs.</span></h2>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {teams.map((t) => (
          <article>
            <div class="overflow-hidden rounded-[24px] bg-pine-800"><img src={url(t.img)} srcset={srcset(t.img)} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" alt="" loading="lazy" class="aspect-[4/5] w-full object-cover" /></div>
            <p class="label mt-5 text-spark">{t.who}</p>
            <h3 class="mt-2 text-[22px] font-medium tracking-tight">{t.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-paper/60">{t.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-t border-white/10 py-24 sm:py-28">
    <div class="wrap">
      <h2 class="display t-h2">Senior craft or AI speed? <span class="accent text-spark">Both.</span></h2>
      <p class="mt-5 max-w-xl text-[17px] text-paper/60">AI does the legwork behind the scenes. People make the calls that matter.</p>
      <div class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-[24px] border border-white/10 bg-white/10 lg:grid-cols-4">
        {stats.map(([n, l]) => (
          <div class="bg-pine-900 p-8"><p class="display text-[56px] text-spark">{n}</p><p class="mt-3 text-[15px] text-paper/60">{l}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-white/10 py-24 sm:py-28">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_2fr]">
      <h2 class="display t-h2">Frequently asked <span class="accent text-spark">questions.</span></h2>
      <div class="divide-y divide-white/10 border-y border-white/10">
        {faq.map((f) => (
          <details>
            <summary class="flex items-center justify-between gap-6 py-5 text-[18px] font-medium hover:text-spark">
              {f.q}
              <span class="faq-plus grid size-8 shrink-0 place-items-center rounded-full border border-white/15 text-[18px] text-paper/70 transition"><svg viewBox="0 0 12 12" class="size-3" fill="none" aria-hidden="true"><path d="M6 0v12M0 6h12" stroke="currentColor" stroke-width="1.5"/></svg></span>
            </summary>
            <p class="max-w-2xl pb-6 text-[16px] leading-relaxed text-paper/65">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Book a call: same section as the homepage -->
  <BookCall />
</Layout>
