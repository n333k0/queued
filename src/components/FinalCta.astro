---
import { spotsOpen } from '../data/site';
import { url } from '../lib/url';
import { srcset } from '../lib/img';
---

<section class="wrap pb-12">
  <div class="relative overflow-hidden rounded-[36px] bg-spark px-6 py-20 text-center text-ink sm:py-28">
    <img class="absolute right-[-36px] top-[-30px] size-[110px] rotate-6 rounded-[20px] object-cover sm:size-[170px] md:right-[-60px] md:top-[-40px] md:size-[260px] md:rounded-[28px]" src={url('/work/tokni.webp')} srcset={srcset('/work/tokni.webp')} sizes="(min-width: 768px) 260px, 170px" alt="" loading="lazy" />
    <img class="absolute bottom-[-36px] left-[-30px] size-[100px] -rotate-6 rounded-[20px] object-cover sm:size-[150px] md:bottom-[-50px] md:left-[-40px] md:size-[220px] md:rounded-[28px]" src={url('/placeholder/brand-packaging.webp')} srcset={srcset('/placeholder/brand-packaging.webp')} sizes="(min-width: 768px) 260px, 170px" alt="" loading="lazy" />
    <div class="relative @container">
      <p class="label text-ink/60">Subscribe. Request. Receive.</p>
      <!-- one line from sm up (max 115px), sized to the card so it never overflows; same size as handled -->
      <h2 class="display mx-auto mt-6 text-[48px] sm:whitespace-nowrap sm:text-[min(115px,9.9cqw)]"><span class="block sm:inline">Queue it.</span> <span class="accent block sm:inline">We’ll ship it.</span></h2>
      <div class="mx-auto mt-10 flex max-w-sm flex-col items-center justify-center gap-3 sm:max-w-none sm:flex-row">
        <a href={url('/#pricing')} class="btn-ink h-14 px-8 text-[16px] btn-wide">Start today</a>
        <a href={url('/#book')} data-call class="btn-line-ink h-14 px-8 text-[16px] btn-wide">Book a 15-min call</a>
      </div>
      <p class="label mt-8 text-ink/60">{spotsOpen} member spot{spotsOpen === 1 ? '' : 's'} open · pause or cancel anytime</p>
    </div>
  </div>
</section>
