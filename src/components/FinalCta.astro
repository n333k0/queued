---
import { spotsOpen } from '../data/site';
import { url } from '../lib/url';
---

<section class="wrap pb-24">
  <div class="relative overflow-hidden rounded-[36px] bg-spark px-6 py-20 text-center text-ink sm:py-28">
    <img class="absolute right-[-60px] top-[-40px] hidden size-[260px] rotate-6 rounded-[28px] object-cover md:block" src={url('/work/tokni.webp')} alt="" loading="lazy" />
    <img class="absolute bottom-[-50px] left-[-40px] hidden size-[220px] -rotate-6 rounded-[28px] object-cover md:block" src={url('/placeholder/brand-packaging.webp')} alt="" loading="lazy" />
    <div class="relative">
      <p class="label text-ink/60">Subscribe. Request. Receive.</p>
      <h2 class="display mx-auto mt-6 max-w-[16ch] t-big">Queue it. <span class="accent">We’ll ship it.</span></h2>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={url('/#pricing')} class="btn-ink h-14 px-8 text-[16px]">Start today</a>
        <a href={url('/#book')} data-call class="btn-line-ink h-14 px-8 text-[16px]">Book a 15-min call</a>
      </div>
      <p class="label mt-8 text-ink/60">{spotsOpen} member spot{spotsOpen === 1 ? '' : 's'} open · pause or cancel anytime</p>
    </div>
  </div>
</section>
