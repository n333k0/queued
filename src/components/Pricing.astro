---
import { url } from '../lib/url';
import { plan, guarantees, links, brand, spotsOpen, capacity } from '../data/site';
---

<section id="pricing" class="bg-paper py-12 text-ink sm:py-16">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="label text-pine-500">Pricing</p>
      <h2 class="display mt-4 t-h2">One subscription. <span class="accent">Endless requests.</span></h2>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-[1.25fr_1fr]">
      <!-- Plan card -->
      <article class="relative rounded-[40px] bg-pine-900 p-8 text-paper sm:p-12" data-reveal>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="text-[26px] font-semibold tracking-tight">{plan.name}</h3>
          <span class="chip border-spark/40 text-spark"><span class="dot"></span>{spotsOpen} of {capacity.total} spots open</span>
        </div>
        <p class="label mt-2 text-paper/45">Pause or cancel anytime</p>

        <div class="mt-8 flex items-baseline gap-2">
          <span id="plan-price" class="display t-price">{plan.priceLabel}</span>
          <span class="text-[18px] text-paper/55">{plan.period}</span>
        </div>

        <label class="mt-6 flex cursor-pointer items-center justify-between gap-4 rounded-2xl border border-white/10 p-4 has-[:checked]:border-spark/60 has-[:checked]:bg-spark/5">
          <span>
            <span class="block text-[15px] font-semibold">Add a second lane</span>
            <span class="block text-[14px] text-paper/55">Two requests in progress at once. {plan.laneLabel}</span>
          </span>
          <input id="lane" type="checkbox" class="size-5 shrink-0 accent-[#ff6a3d]" />
        </label>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href={links.checkout} class="btn-primary h-14 sm:flex-1 text-[16px]">Join today</a>
          <a href={url('/#book')} data-call class="btn-ghost h-14 sm:flex-1 text-[16px]">Book a 15-min call</a>
        </div>

        <ul class="mt-8 grid gap-3 border-t border-white/10 pt-8 text-[15px] sm:grid-cols-2">
          {plan.includes.map((item) => (
            <li class="flex gap-3">
              <svg class="mt-1 shrink-0 text-spark" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m2 7.5 3 3 7-7" stroke="currentColor" stroke-width="1.8" /></svg>
              {item}
            </li>
          ))}
        </ul>
      </article>

      <!-- Guarantees + sibling -->
      <div class="grid gap-6">
        {guarantees.map((g, i) => (
          <div class="rounded-[40px] border border-ink/10 bg-white p-8 sm:p-10" data-reveal>
            <p class="font-mono text-[13px] text-pine-500">0{i + 1}</p>
            <h3 class="mt-4 text-[24px] font-semibold tracking-tight">{g.title}</h3>
            <p class="mt-2 text-[16px] text-ink/60">{g.body}</p>
          </div>
        ))}
        <a href={brand.sibling.url} class="group flex items-center justify-between gap-4 rounded-[40px] bg-ink p-8 text-paper sm:p-10" data-reveal>
          <span>
            <span class="label text-paper/45">From RemotoLabs</span>
            <span class="mt-2 block text-[22px] font-semibold tracking-tight">shipped.</span>
            <span class="mt-1 block text-[15px] text-paper/60">{brand.sibling.line}</span>
          </span>
          <span class="grid size-11 shrink-0 place-items-center rounded-full border border-white/20 transition group-hover:border-spark group-hover:text-spark">→</span>
        </a>
      </div>
    </div>

    <!-- Other ways to subscribe -->
    <a href={url('/subscriptions/')} class="group mt-6 flex flex-col items-start justify-between gap-4 rounded-[40px] border border-ink/10 bg-white p-8 sm:flex-row sm:items-center sm:p-10" data-reveal>
      <span>
        <span class="label text-pine-500">Other subscriptions</span>
        <span class="mt-2 block text-[22px] font-semibold tracking-tight">Membership, Team or Projects.</span>
        <span class="mt-1 block text-[15px] text-ink/60">Need two requests at once, or one fixed-price project? Compare every way to work.</span>
      </span>
      <span class="btn-ink h-12 shrink-0 px-6 text-[15px]">See all subscriptions →</span>
    </a>
  </div>
</section>

<script define:vars={{ base: plan.price, lane: plan.lanePrice }}>
  const box = document.getElementById('lane');
  const out = document.getElementById('plan-price');
  box?.addEventListener('change', () => {
    out.textContent = '$' + (box.checked ? base + lane : base).toLocaleString('en-US');
  });
</script>
