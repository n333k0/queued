---
import { url } from '../lib/url';
import Logo from './Logo.astro';
import { links as integ, spotsOpen } from '../data/site';

const nav = [
  { href: '/#benefits', label: 'Benefits' },
  { href: '/#work', label: 'Work' },
  { href: '/#scope', label: 'Scope' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/pricing/', label: 'Subscriptions' },
  { href: '/#faq', label: 'FAQ' },
];
---

<header class="site-header fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-pine-900/80 backdrop-blur-xl">
  <div class="bar wrap flex h-[68px] items-center justify-between gap-6">
    <Logo />

    <nav class="hidden items-center gap-8 text-[14px] text-paper/80 lg:flex" aria-label="Main">
      {nav.map((l) => <a href={url(l.href)} class="transition hover:text-paper">{l.label}</a>)}
    </nav>

    <div class="flex items-center gap-3">
      <a href={integ.portal} class="hidden text-[14px] text-paper/70 transition hover:text-paper md:inline">Login</a>
      <a href={url('/#book')} data-call class="btn-ghost hidden h-10 px-5 text-[14px] sm:inline-flex">Book a call</a>
      <a href={url('/#pricing')} class="btn-primary h-10 px-5 text-[14px]">See pricing</a>
      <details class="relative lg:hidden">
        <summary class="grid size-10 place-items-center rounded-full border border-white/20" aria-label="Menu">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 5h12M2 11h12" stroke="currentColor" stroke-width="1.5" /></svg>
        </summary>
        <nav class="absolute right-0 top-12 w-56 rounded-2xl border border-white/10 bg-pine-800 p-2 shadow-2xl" aria-label="Mobile">
          {nav.map((l) => <a href={url(l.href)} class="block rounded-xl px-4 py-3 text-[15px] hover:bg-white/5">{l.label}</a>)}
          <a href={url('/#book')} data-call class="block rounded-xl px-4 py-3 text-[15px] hover:bg-white/5">Book a call</a>
          <a href={integ.portal} class="block rounded-xl px-4 py-3 text-[15px] text-paper/60 hover:bg-white/5">Login</a>
          <p class="label px-4 py-3 text-paper/40">{spotsOpen} member spots open</p>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the mobile menu after picking a link.
  document.querySelectorAll('header details a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>
