---
import { url } from '../lib/url';
import Logo from './Logo.astro';
import { links as integ, spotsOpen } from '../data/site';

const { minimal = false, overlay = false } = Astro.props;
const nav = [
  { href: '/#benefits', label: 'Benefits' },
  { href: '/#work', label: 'Work' },
  { href: '/#scope', label: 'Scope' },
  { href: '/subscriptions/', label: 'Subscriptions' },
  { href: '/#faq', label: 'FAQ' },
];
---

<header data-overlay={overlay ? '' : undefined} class="site-header fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-pine-900/80 backdrop-blur-xl">
  <div class="bar wrap flex h-[68px] items-center justify-between gap-6">
    <Logo />

    <nav class="hidden items-center gap-8 text-[14px] text-paper/80 lg:flex" aria-label="Main">
      {nav.map((l) => <a href={url(l.href)} class="transition hover:text-paper">{l.label}</a>)}
    </nav>

    <div class="flex items-center gap-3">
      <a href={integ.portal} class="hidden text-[14px] text-paper/70 transition hover:text-paper md:inline">Login</a>
      <a href={overlay ? '#book' : url('/#book')} data-call class="btn-ghost hidden h-10 px-5 text-[14px] sm:inline-flex">Book a call</a>
      <a href={Astro.url.pathname.replace(/\/$/, '').endsWith('/subscriptions') ? '#ways' : url('/#pricing')} class="btn-primary h-10 px-5 text-[14px]">See pricing</a>
      <button type="button" class="menu-btn grid size-10 shrink-0 place-items-center rounded-full border border-white/20 lg:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="m-nav">
            <span class="burger" aria-hidden="true"><i></i><i></i></span>
          </button>
    </div>
    <!-- mobile menu: the pill itself grows to fill the screen (see .m-nav in global.css) -->
    <nav id="m-nav" class="m-nav lg:hidden" aria-label="Mobile">
      {nav.map((l, i) => <a href={url(l.href)} style={`--i:${i}`} class="block py-2.5 text-[30px] font-medium leading-tight tracking-tight text-paper/90 transition hover:text-spark">{l.label}</a>)}
      <a href={url('/#book')} data-call style={`--i:${nav.length}`} class="btn-primary h-14 w-full text-[16px]">
        Book a free 15-min call
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4-4 4" stroke="currentColor" stroke-width="1.6" /></svg>
      </a>
    </nav>
  </div>
</header>

<script>
  // Mobile menu: opening it grows the nav pill to full screen.
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const btn = header.querySelector<HTMLButtonElement>('.menu-btn');
  const setMenu = (open: boolean) => {
    header.setAttribute('data-anim', ''); // transitions only after first use, so page load doesn't animate
    header.toggleAttribute('data-menu', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  btn?.addEventListener('click', () => setMenu(!header.hasAttribute('data-menu')));
  header.querySelectorAll('.m-nav a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));
  matchMedia('(min-width: 1024px)').addEventListener('change', (m) => m.matches && setMenu(false));
</script>
