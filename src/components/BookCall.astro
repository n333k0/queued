---
// 15-min intro call. With links.calendly set, this is the live Calendly embed.
// Without it, a preview of the same booking UI is shown (slots open an email).
import ParentLogo from './ParentLogo.astro';
import { links, brand } from '../data/site';

// Preview calendar: next 3 weeks of weekdays, starting tomorrow.
const days: { d: Date; open: boolean }[] = [];
const start = new Date();
for (let i = 1; days.length < 15; i++) {
  const d = new Date(start);
  d.setDate(start.getDate() + i);
  if (d.getDay() === 0 || d.getDay() === 6) continue;
  days.push({ d, open: days.length % 4 !== 2 });
}
const slots = ['9:30', '10:15', '11:00', '14:00', '15:30', '16:15'];
const fmtDay = (d: Date) => d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
---

<section id="book" class="border-y border-white/10 bg-pine-950 py-24 sm:py-32">
  <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.5fr] lg:gap-16">
    <div data-reveal>
      <p class="label text-spark">Book a call</p>
      <h2 class="display mt-4 t-h2"><span class="block">Book a 15&#8209;min</span> <span class="accent block text-spark">intro call.</span></h2>
      <p class="mt-6 max-w-md text-[18px] text-paper/65">A quick guided tour of how queued. works, and whether it’s the right fit. Spoiler: it probably is.</p>
      <p class="mt-8 text-[15px] text-paper/55">Prefer to email? <a href={`mailto:${brand.email}`} class="text-paper underline underline-offset-4">{brand.email}</a></p>
    </div>

    <div data-reveal>
      {links.calendly ? (
        <div class="calendly-inline-widget overflow-hidden rounded-[28px] bg-white" data-url={`${links.calendly}?hide_gdpr_banner=1&background_color=ffffff&primary_color=ff6a3d`} style="min-width:320px;height:700px;"></div>
      ) : (
        <div class="overflow-hidden rounded-[28px] border border-white/10 md:grid md:grid-cols-[220px_1fr]">
          <div class="border-b border-white/10 p-6 md:border-b-0 md:border-r">
            <ParentLogo class="h-[12px] text-paper/70" />
            <p class="mt-6 text-[22px] font-semibold tracking-tight">Intro call</p>
            <ul class="mt-4 space-y-2 text-[14px] text-paper/60">
              <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-spark"></span>15 minutes</li>
              <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-spark"></span>Video call</li>
              <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-spark"></span>No prep needed</li>
            </ul>
          </div>
          <div class="p-6">
            <p class="text-[16px] font-medium">Select a day</p>
            <div class="mt-4 grid grid-cols-5 gap-2" role="list">
              {days.map((x, i) => (
                <button type="button" data-day={fmtDay(x.d)} disabled={!x.open} class:list={['day rounded-xl border px-1 py-2 text-center text-[13px] transition', x.open ? 'border-white/15 hover:border-spark' : 'cursor-not-allowed border-transparent text-paper/25', i === 0 && 'border-spark bg-spark/10']}>
                  <span class="block font-mono text-[10px] uppercase text-paper/45">{x.d.toLocaleDateString('en-US', { weekday: 'short' })}</span>
                  <span class="block text-[16px] font-medium">{x.d.getDate()}</span>
                </button>
              ))}
            </div>
            <p class="mt-6 text-[14px] text-paper/55"><span id="day-label">{fmtDay(days[0].d)}</span> · your time zone</p>
            <div class="mt-3 grid grid-cols-3 gap-2">
              {slots.map((t) => (
                <a href={`mailto:${brand.email}?subject=Intro%20call&body=I'd%20like%20the%20${t}%20slot.`} data-slot={t} class="slot rounded-xl border border-spark/40 py-2.5 text-center text-[14px] font-medium text-spark transition hover:bg-spark hover:text-ink">{t}</a>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  // Preview calendar: selecting a day updates the label and the email links.
  const label = document.getElementById('day-label');
  document.querySelectorAll<HTMLButtonElement>('#book .day:not([disabled])').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('#book .day').forEach((x) => x.classList.remove('border-spark', 'bg-spark/10'));
      b.classList.add('border-spark', 'bg-spark/10');
      if (label) label.textContent = b.dataset.day ?? '';
      document.querySelectorAll<HTMLAnchorElement>('#book .slot').forEach((s) => {
        s.href = s.href.replace(/body=.*/, `body=I'd%20like%20${encodeURIComponent(`${b.dataset.day} at ${s.dataset.slot}`)}.`);
      });
    }),
  );
</script>
