---
import { url } from '../lib/url';
import { srcset } from '../lib/img';
import ParentLogo from './ParentLogo.astro';
import Shader from './Shader.astro';
import { brand, plan, spotsOpen, capacity } from '../data/site';

// Device shots and design work: /work = our projects, /placeholder = stand-ins to replace.
const tiles = [
  { src: '/placeholder/v-donuts.mp4', w: 'w-[260px] sm:w-[320px]', h: 'h-[320px] sm:h-[400px]' },
  { src: '/placeholder/laptop-typing.webp', w: 'w-[220px] sm:w-[280px]', h: 'h-[260px] sm:h-[320px]' },
  { src: '/placeholder/g-sushi.webp', w: 'w-[220px] sm:w-[260px]', h: 'h-[220px] sm:h-[260px]' },
  { src: '/placeholder/v-sponge.mp4', w: 'w-[260px] sm:w-[320px]', h: 'h-[320px] sm:h-[400px]' },
  { src: '/work/1red-wide.webp', w: 'w-[340px] sm:w-[460px]', h: 'h-[220px] sm:h-[280px]' },
  { src: '/placeholder/pricing-social.webp', w: 'w-[250px] sm:w-[300px]', h: 'h-[280px] sm:h-[340px]' },
  { src: '/placeholder/brand-packaging.webp', w: 'w-[200px] sm:w-[240px]', h: 'h-[300px] sm:h-[360px]' },
  { src: '/placeholder/v-ball.mp4', w: 'w-[260px] sm:w-[320px]', h: 'h-[320px] sm:h-[400px]' },
  { src: '/work/tokni.webp', w: 'w-[240px] sm:w-[320px]', h: 'h-[300px] sm:h-[380px]' },
  { src: '/placeholder/g-cocktail.webp', w: 'w-[200px] sm:w-[240px]', h: 'h-[280px] sm:h-[340px]' },
  { src: '/placeholder/tablet-method.webp', w: 'w-[240px] sm:w-[300px]', h: 'h-[260px] sm:h-[320px]' },
  { src: '/placeholder/v-illo.mp4', w: 'w-[260px] sm:w-[320px]', h: 'h-[260px] sm:h-[320px]' },
  { src: '/work/perfect-body-wide.webp', w: 'w-[360px] sm:w-[450px]', h: 'h-[240px] sm:h-[300px]' },
  { src: '/placeholder/merch-box.webp', w: 'w-[220px] sm:w-[260px]', h: 'h-[220px] sm:h-[260px]' },
];
const loop = [...tiles, ...tiles];
---

<section class="relative overflow-hidden pt-[88px] sm:pt-[116px]">
  <!-- grainy ember shader behind the copy and the reel -->
  <Shader class="absolute inset-0" />
  <div class="wrap relative text-center">
    <a href={url('/#pricing')} class="chip mx-auto border-white/15 bg-white/5 text-paper/80 hover:border-spark/60">
      <span class="dot"></span>
      {spotsOpen} of {capacity.total} member spots open
    </a>

    <h1 class="display mx-auto mt-6 max-w-[14ch] t-hero">
      Your design team. <span class="accent text-spark">On subscription.</span>
    </h1>

    <p class="mx-auto mt-5 max-w-[680px] text-[16px] leading-relaxed text-paper/75 sm:text-[17px]">
      A senior design team that works inside your workflow. Websites, product UI, brand, decks and ads in about 48 hours each, for one flat monthly fee. Skip the hiring round. Pause anytime.
    </p>

    <div class="mx-auto mt-7 flex max-w-sm flex-col items-center justify-center gap-3 sm:max-w-none sm:flex-row">
      <a href={url('/#pricing')} class="btn-primary h-14 px-8 text-[16px] btn-wide">
        Start today
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4-4 4" stroke="currentColor" stroke-width="1.6" /></svg>
      </a>
      <a href={url('/#book')} data-call class="btn-ghost h-14 px-8 text-[16px] btn-wide">Book a 15-min call</a>
    </div>

    <ul class="label mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-paper/50">
      <li>Unlimited requests</li>
      <li aria-hidden="true">/</li>
      <li>~48h delivery</li>
      <li aria-hidden="true">/</li>
      <li>Pause anytime</li>
      <li aria-hidden="true">/</li>
      <li>{plan.priceLabel}{plan.period}</li>
    </ul>

    <a href={brand.parentUrl} class="mt-10 inline-flex items-center gap-2 text-white/90 transition hover:text-white" aria-label={`${brand.parentLine} ${brand.parent}`}>
      <span class="font-sans text-[14px] leading-none text-paper/55">{brand.parentLine}</span>
      <ParentLogo class="h-[14px]" />
    </a>
  </div>

  <div class="reel relative mt-12 sm:mt-14" aria-label="Recent work">
    <div class="flex w-max items-end gap-4 animate-marquee hover:[animation-play-state:paused]">
      {loop.map((t, i) => (
        <div class:list={['shrink-0 overflow-hidden rounded-[22px] bg-pine-800', t.w, t.h]} aria-hidden={i >= tiles.length ? 'true' : undefined}>
          {t.src.endsWith('.mp4') ? (
            <video class="size-full object-cover" src={url(t.src)} muted loop playsinline preload="none" poster={url(t.src.replace('.mp4', '-poster.webp'))} data-autoplay></video>
          ) : (
            <img class="size-full object-cover" src={url(t.src)} srcset={srcset(t.src)} sizes="(min-width: 640px) 320px, 260px" alt="" loading={i < 5 ? 'eager' : 'lazy'} />
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Facts strip -->
<section class="mt-8 border-y border-white/10 sm:mt-12">
  <div class="wrap grid grid-cols-2 divide-white/10 md:grid-cols-4 md:divide-x">
    {[
      ['Unlimited', 'Requests and revisions.'],
      ['~48 hours', 'Average delivery per request.'],
      ['Pause anytime', 'Unused days wait for you.'],
      ['100% yours', 'Every file, every pixel.'],
    ].map(([k, v]) => (
      <div class="px-2 py-8 md:px-8">
        <p class="text-[22px] font-medium tracking-tight sm:text-[26px]">{k}</p>
        <p class="mt-1 text-[14px] text-paper/55">{v}</p>
      </div>
    ))}
  </div>
</section>

<style>
  /* reel edges fade out softly so the shader shows through, no dark bars */
  .reel { -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent); }
</style>
