---
import { benefits } from '../data/site';

const ticker = ['Unlimited requests', 'Fixed monthly rate', '~48-hour delivery', 'Senior quality', 'Pause anytime'];

// Small line icons, one per benefit (same order as data).
const icons = [
  'M4 5h6v14H4zM14 5h6v8h-6z', // board
  'M12 3v18M7 7h7a3 3 0 0 1 0 6H10a3 3 0 0 0 0 6h7', // fixed rate
  'M13 2 4 14h7l-1 8 9-12h-7z', // fast
  'm12 3 2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z', // quality
  'M4 12h16M12 4v16', // flexible
  'M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z', // yours
];
---

<section id="benefits" class="scroll-mt-[55px] bg-pine-950 pt-[29px] pb-24 sm:scroll-mt-[75px] sm:pt-[25px] sm:pb-32">
  <div class="wrap">
    <!-- Section divider: accent block with the membership promises on a loop. The Benefits link lands here. -->
    <div class="overflow-hidden rounded-[28px] bg-spark px-4 py-7 text-ink sm:px-8 sm:py-9" role="img" aria-label={ticker.join(', ')}>
      <div class="ticker overflow-hidden">
      <div class="flex w-max animate-ticker" aria-hidden="true">
        {[0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {ticker.map((t) => (
              <span class="flex items-center whitespace-nowrap text-[32px] font-medium tracking-[-0.02em] sm:text-[48px] lg:text-[56px]">
                <span class="px-6 sm:px-8">{t}</span>
                <svg viewBox="0 0 24 24" class="size-5 sm:size-7" fill="currentColor"><path d="M12 0c.6 6.4 5.6 11.4 12 12-6.4.6-11.4 5.6-12 12-.6-6.4-5.6-11.4-12-12C6.4 11.4 11.4 6.4 12 0z" /></svg>
              </span>
            ))}
          </div>
        ))}
      </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col justify-between gap-6 sm:mt-14 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="label text-spark">Membership benefits</p>
        <h2 class="display mt-4 t-h2">It’s “you’ll never go back” <span class="accent text-spark">better.</span></h2>
      </div>
      <p class="max-w-sm text-[16px] text-paper/60">Replaces unreliable freelancers and expensive agencies with one flat monthly fee, and designs delivered so fast you won’t want to go anywhere else.</p>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-[28px] border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
      {benefits.map((b, i) => (
        <div class="flex gap-4 bg-pine-950 p-5 sm:gap-5 sm:px-7 sm:py-6">
          <svg class="mt-0.5 size-6 shrink-0 text-spark" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d={icons[i]} /></svg>
          <div>
            <h3 class="text-[18px] font-medium tracking-tight sm:text-[20px]">{b.title}</h3>
            <p class="mt-1.5 text-[14px] leading-relaxed text-paper/60 sm:text-[15px]">{b.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
