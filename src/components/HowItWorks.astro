---
import { steps, board, plan } from '../data/site';

const tagColor: Record<string, string> = {
  Web: 'bg-sky-400/15 text-sky-300',
  Deck: 'bg-violet-400/15 text-violet-300',
  Social: 'bg-pink-400/15 text-pink-300',
  Product: 'bg-spark/15 text-spark',
  Brand: 'bg-amber-300/15 text-amber-200',
  Email: 'bg-emerald-400/15 text-emerald-300',
  Ads: 'bg-rose-400/15 text-rose-300',
};
---

<section id="how" class="py-24 sm:py-32">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="label text-spark">How it works</p>
      <h2 class="display mt-4 text-[clamp(40px,6vw,80px)]">The way design should’ve worked <span class="accent text-spark">all along.</span></h2>
    </div>

    <ol class="mt-14 grid gap-5 md:grid-cols-3">
      {steps.map((s) => (
        <li class="flex flex-col rounded-[28px] border border-white/10 bg-white/[0.03] p-7" data-reveal>
          <p class="font-mono text-[13px] text-spark">{s.n}</p>
          <h3 class="mt-5 text-[30px] font-medium tracking-tight">{s.title}</h3>
          <p class="mt-3 text-[16px] leading-relaxed text-paper/60">{s.body}</p>

          <div class="mt-8 rounded-2xl border border-white/10 bg-pine-800 p-4 text-[13px]" aria-hidden="true">
            {s.ui === 'subscribe' && (
              <div>
                <div class="flex items-center justify-between"><span class="text-paper/60">{plan.name}</span><span class="font-medium">{plan.priceLabel}<span class="text-paper/45">{plan.period}</span></span></div>
                <div class="mt-3 flex items-center justify-between rounded-xl bg-spark px-3 py-2 font-semibold text-ink"><span>Start today</span><span>→</span></div>
                <p class="label mt-3 text-paper/40">Board ready in under an hour</p>
              </div>
            )}
            {s.ui === 'request' && (
              <div class="space-y-2">
                {['Pricing page redesign', 'Q4 investor deck', 'Instagram set × 6'].map((t, i) => (
                  <div class="flex items-center gap-2 rounded-xl bg-white/[0.05] px-3 py-2"><span class="font-mono text-[11px] text-paper/40">{i + 1}</span>{t}</div>
                ))}
                <div class="rounded-xl border border-dashed border-white/20 px-3 py-2 text-paper/40">+ Add a request</div>
              </div>
            )}
            {s.ui === 'receive' && (
              <div>
                <div class="flex items-center gap-2"><span class="grid size-5 place-items-center rounded-full bg-spark text-[11px] text-ink">✓</span><span>Onboarding flow delivered</span></div>
                <div class="mt-3 grid grid-cols-3 gap-1.5">
                  {[1, 2, 3].map(() => <div class="aspect-[3/4] rounded-md bg-gradient-to-b from-white/15 to-white/5"></div>)}
                </div>
                <p class="label mt-3 text-paper/40">2 days · Figma + prototype</p>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>

    <!-- The board -->
    <div class="mt-16 rounded-[28px] border border-white/10 bg-pine-800 p-2" data-reveal>
      <div class="flex items-center gap-1.5 px-4 py-3" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span>
        <span class="label ml-3 text-paper/35">Your request board</span>
      </div>
      <div class="overflow-x-auto rounded-[22px] bg-pine-900 p-4 sm:p-6">
        <div class="grid min-w-[760px] grid-cols-4 gap-4">
          {board.map((c) => (
            <div>
              <p class="label flex items-center justify-between text-paper/45">{c.col}<span>{c.cards.length}</span></p>
              <ul class="mt-3 space-y-2">
                {c.cards.map((card: { t: string; tag: string; live?: boolean }) => (
                  <li class:list={['rounded-xl border p-3 text-[14px]', card.live ? 'border-spark/50 bg-spark/10' : 'border-white/10 bg-white/[0.03]', c.col === 'Done' && 'text-paper/50']}>
                    <p class:list={[c.col === 'Done' && 'line-through decoration-white/20']}>{card.t}</p>
                    <div class="mt-2 flex items-center justify-between">
                      <span class:list={['rounded-full px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.1em]', tagColor[card.tag] ?? 'bg-white/10 text-paper/60']}>{card.tag}</span>
                      {card.live && <span class="label flex items-center gap-1.5 text-spark"><span class="dot"></span>Due Wed</span>}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
    <p class="mt-5 text-center text-[15px] text-paper/50">Brief it however you like: a doc, a Figma link, a wireframe or a two-minute Loom.</p>
  </div>
</section>
