---
import { url } from '../lib/url';
import { srcset } from '../lib/img';
import { steps, board, plan } from '../data/site';

const tagColor: Record<string, string> = {
  Web: 'bg-sky-400/15 text-sky-300',
  Deck: 'bg-violet-400/15 text-violet-300',
  Social: 'bg-pink-400/15 text-pink-300',
  Product: 'bg-spark/15 text-spark',
  Brand: 'bg-amber-300/15 text-amber-200',
  Email: 'bg-emerald-400/15 text-emerald-300',
  Ads: 'bg-rose-400/15 text-rose-300',
};

---

<section id="how" class="pt-12 sm:pt-16">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="label text-spark">How it works</p>
      <h2 class="display mt-4 t-h2">The way design should’ve worked <span class="accent text-spark">all along.</span></h2>
    </div>

    <!-- phones: number beside the title, tighter card; md+: subgrid columns as before -->
    <ol class="mt-8 grid gap-2.5 sm:mt-14 sm:gap-5 md:grid-cols-3 md:grid-rows-[auto_auto_1fr_auto] md:gap-y-0">
      {steps.map((s) => (
        <li class="grid grid-cols-[auto_1fr] items-baseline gap-x-3 rounded-[22px] bg-white/[0.04] p-5 sm:rounded-[28px] sm:p-7 md:row-span-4 md:grid-cols-1 md:grid-rows-subgrid md:items-stretch md:gap-x-0" data-reveal>
          <p class="font-mono text-[13px] text-spark">{s.n}</p>
          <h3 class="text-[24px] font-medium tracking-tight md:mt-5 md:text-[30px]">{s.title}</h3>
          <p class="col-span-2 mt-1.5 text-[14px] leading-snug text-paper/60 md:col-span-1 md:mt-3 md:text-[16px] md:leading-relaxed">{s.body}</p>

          <div class="col-span-2 mt-5 h-[200px] md:col-span-1 md:mt-8 overflow-hidden rounded-2xl bg-black p-4 text-[13px]" aria-hidden="true">
            {s.ui === 'subscribe' && (
              <div class="anim-sub relative flex h-full flex-col" data-anim="subscribe" data-state="0">
                <div class="flex items-center justify-between"><span class="text-paper/60">{plan.name}</span><span class="font-medium">{plan.priceLabel}<span class="text-paper/45">{plan.period}</span></span></div>
                <div class="sub-btn relative mt-3 flex h-12 items-center justify-between rounded-xl bg-spark px-3 font-semibold text-ink transition duration-300">
                  <span class="sub-label">Start today</span><span class="sub-arrow">→</span>
                </div>
                <div class="sub-ready mt-3 flex h-12 items-center gap-2 rounded-xl bg-white/[0.05] px-3 transition duration-500">
                  <span class="grid size-5 place-items-center rounded-full bg-spark text-[11px] text-ink">✓</span>
                  <span>Your board is ready</span>
                </div>
                <p class="label mt-auto text-paper/40">Invite sent · under an hour</p>
                <svg class="sub-cursor absolute h-5 w-5 transition-all duration-700 ease-out" viewBox="0 0 24 24" fill="white" stroke="black" stroke-width="1"><path d="M5 3l14 8-6 2-3 6z" /></svg>
              </div>
            )}
            {s.ui === 'request' && (
              <div data-anim="request">
                <div class="mb-2 flex items-center justify-between text-paper/50"><span class="label">Your queue</span><span class="label"><span class="req-count">3</span> requests</span></div>
                <ul class="req-list space-y-2">
                  {['Pricing page redesign', 'Q4 investor deck', 'Instagram set × 6'].map((t, i) => (
                    <li class="req flex items-center justify-between gap-2 rounded-xl bg-white/[0.05] h-10 px-3">
                      <span class="truncate">{t}</span>
                      <span class:list={['req-status shrink-0 rounded-full px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.08em]', i === 0 ? 'bg-spark/15 text-spark' : 'bg-white/10 text-paper/50']}>{i === 0 ? 'In progress' : 'Queued'}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {s.ui === 'receive' && (
              <div data-anim="receive" data-state="0">
                <div class="flex items-center gap-2">
                  <span class="rcv-icon grid size-5 place-items-center rounded-full border border-white/20 text-[11px] transition duration-300">✓</span>
                  <span class="rcv-title">Onboarding flow</span>
                  <span class="rcv-pct ml-auto font-mono text-[11px] text-paper/45">0%</span>
                </div>
                <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-white/10"><div class="rcv-bar h-full w-0 rounded-full bg-spark"></div></div>
                <!-- one set of three thumbnails per job; the script shows the set that matches the title -->
                <div class="rcv-sets relative mt-3 h-[96px]">
                  <!-- Pricing page: three plan columns, middle one featured -->
                  <div class="rcv-set grid h-full grid-cols-3 gap-1.5" data-job="Pricing page">
                    {['/placeholder/rcv-pricing-1.webp', '/placeholder/rcv-pricing-2.webp', '/placeholder/rcv-pricing-3.webp'].map((src, v) => (
                      <div class="rcv-thumb relative overflow-hidden rounded-md bg-[#f3f1ea]" style={`transition-delay:${v * 150}ms`}>
                        <img src={url(src)} srcset={srcset(src)} sizes="160px" alt="" loading="lazy" class="absolute inset-0 size-full object-cover object-left-top" />
                      </div>
                    ))}
                  </div>
                  <!-- Onboarding flow: three detailed phone screens (sign up → goals → done) -->
                  <div class="rcv-set grid h-full grid-cols-3 gap-1.5" data-job="Onboarding flow">
                    {[0, 1, 2].map((v) => (
                      <div class="rcv-thumb grid place-items-center overflow-hidden rounded-md bg-white/[0.06]" style={`transition-delay:${v * 150}ms`}>
                        <div class="h-[90px] w-[50px] rounded-[10px] bg-[#2a2a2a] p-[2px]">
                          <div class="relative flex h-full flex-col overflow-hidden rounded-[8px] bg-white px-[4px] pb-[4px] pt-[3px] text-black">
                            <div class="flex items-center justify-between text-[3.5px] font-semibold leading-none"><span>9:41</span><span class="h-[3px] w-[11px] rounded-full bg-black"></span><span class="flex gap-[1px]"><span class="h-[2.5px] w-[3px] rounded-[0.5px] bg-black"></span><span class="h-[2.5px] w-[1.5px] rounded-[0.5px] bg-black/40"></span></span></div>
                            <div class="mt-[4px] flex gap-[1.5px]">{[0, 1, 2].map((d) => <span class:list={['h-[1.5px] flex-1 rounded-full', d <= v ? 'bg-[#eb4f2b]' : 'bg-black/10']}></span>)}</div>
                            {v === 0 && <>
                              <span class="mt-[5px] grid size-[9px] place-items-center rounded-[3px] bg-[#eb4f2b] text-[5px] font-semibold leading-none text-black">n</span>
                              <p class="mt-[3px] text-[5.5px] font-semibold leading-[1.1] tracking-tight">Create your account</p>
                              <p class="mt-[1px] text-[3px] leading-tight text-black/45">Takes about a minute.</p>
                              <p class="mt-[3px] text-[2.8px] font-medium text-black/55">Email</p>
                              <div class="mt-[1px] flex h-[7px] items-center rounded-[2px] border-[0.5px] border-black/20 px-[2px] text-[3px] text-black/70">ana@nova.co</div>
                              <p class="mt-[2px] text-[2.8px] font-medium text-black/55">Password</p>
                              <div class="mt-[1px] flex h-[7px] items-center gap-[1px] rounded-[2px] border-[0.5px] border-[#eb4f2b] px-[2px]">{[0, 1, 2, 3, 4, 5].map(() => <span class="size-[1.5px] rounded-full bg-black/70"></span>)}</div>
                              <div class="mt-auto grid h-[8px] place-items-center rounded-full bg-black text-[3.5px] font-medium text-white">Continue</div>
                            </>}
                            {v === 1 && <>
                              <p class="mt-[5px] text-[5.5px] font-semibold leading-[1.1] tracking-tight">What brings you here?</p>
                              <p class="mt-[1px] text-[3px] leading-tight text-black/45">Pick all that apply.</p>
                              <div class="mt-[4px] grid grid-cols-2 gap-[2px]">
                                {[['Sales', 1], ['Ops', 0], ['Hiring', 0], ['Finance', 1], ['Support', 0], ['Design', 1]].map(([t, on]) => (
                                  <span class:list={['flex h-[8px] items-center gap-[1px] rounded-[2px] px-[2px] text-[3px] font-medium', on ? 'bg-[#eb4f2b]/12 text-[#d9481c] ring-[0.5px] ring-[#eb4f2b]' : 'bg-black/[0.05] text-black/60']}>{on ? '✓' : ''}{t}</span>
                                ))}
                              </div>
                              <div class="mt-auto grid h-[8px] place-items-center rounded-full bg-black text-[3.5px] font-medium text-white">Continue · 3</div>
                            </>}
                            {v === 2 && <>
                              <div class="relative mx-auto mt-[8px] grid size-[16px] place-items-center rounded-full bg-[#eb4f2b] text-[7px] leading-none text-black">✓
                                <span class="absolute -left-[5px] top-0 size-[2px] rounded-full bg-[#ffc2ad]"></span><span class="absolute -right-[4px] top-[3px] size-[1.5px] rounded-full bg-[#eb4f2b]"></span><span class="absolute -right-[6px] bottom-0 size-[2px] rounded-full bg-black/20"></span>
                              </div>
                              <p class="mt-[4px] text-center text-[5.5px] font-semibold leading-[1.1] tracking-tight">You’re all set</p>
                              <p class="mt-[1px] text-center text-[3px] leading-tight text-black/45">Your workspace is ready.</p>
                              <div class="mx-auto mt-[4px] flex -space-x-[2px]">{['#ffb199', '#c8bdff', '#9be0c4'].map((c) => <span class="size-[6px] rounded-full ring-[0.5px] ring-white" style={`background:${c}`}></span>)}</div>
                              <p class="mt-[1px] text-center text-[2.8px] text-black/45">3 teammates invited</p>
                              <div class="mt-auto grid h-[8px] place-items-center rounded-full bg-[#eb4f2b] text-[3.5px] font-medium text-black">Get started</div>
                            </>}
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                  <!-- Pitch deck: title slide, chart slide, big-number slide, with slide numbers -->
                  <div class="rcv-set grid h-full grid-cols-3 gap-1.5" data-job="Pitch deck v2">
                    {[0, 1, 2].map((v) => (
                      <div class="rcv-thumb flex flex-col justify-center gap-1.5 overflow-hidden rounded-md bg-white/[0.06] p-1.5" style={`transition-delay:${v * 150}ms`}>
                        {v === 0 && (
                          <div class="relative aspect-video w-full overflow-hidden rounded-[3px] bg-[#111] p-[5px] text-white">
                            <span class="absolute -bottom-4 -right-3 size-12 rounded-full bg-[#eb4f2b] opacity-90 blur-[6px]"></span>
                            <span class="relative flex items-center gap-[2px] text-[3.5px] font-semibold"><span class="size-[3px] rounded-full bg-[#eb4f2b]"></span>Nova</span>
                            <p class="relative mt-[5px] text-[8px] font-semibold leading-none tracking-tight">Series A</p>
                            <p class="relative mt-[2px] text-[3.5px] text-white/60">Investor update · Q4 2026</p>
                          </div>
                        )}
                        {v === 1 && (
                          <div class="aspect-video w-full overflow-hidden rounded-[3px] bg-[#f6f5f1] px-[5px] py-[4px] text-black">
                            <div class="flex items-baseline justify-between"><span class="text-[4.5px] font-semibold tracking-tight">Revenue</span><span class="text-[3.5px] font-semibold text-[#e5532a]">+182% YoY</span></div>
                            <svg viewBox="0 0 80 30" class="mt-[2px] h-[calc(100%-8px)] w-full" preserveAspectRatio="none" aria-hidden="true">
                              <defs><linearGradient id="dk-g" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#eb4f2b" stop-opacity=".35" /><stop offset="1" stop-color="#eb4f2b" stop-opacity="0" /></linearGradient></defs>
                              {[8, 16, 24].map((y) => <line x1="0" x2="80" y1={y} y2={y} stroke="#000" stroke-opacity=".08" stroke-width=".5" />)}
                              <path d="M0 26 L13 24 L26 21 L40 22 L53 15 L66 10 L80 3 L80 30 L0 30Z" fill="url(#dk-g)" />
                              <path d="M0 26 L13 24 L26 21 L40 22 L53 15 L66 10 L80 3" fill="none" stroke="#eb4f2b" stroke-width="1.2" stroke-linejoin="round" />
                              <circle cx="80" cy="3" r="1.6" fill="#eb4f2b" />
                            </svg>
                          </div>
                        )}
                        {v === 2 && (
                          <div class="flex aspect-video w-full flex-col justify-between overflow-hidden rounded-[3px] bg-[#eb4f2b] p-[5px] text-black">
                            <div><p class="text-[12px] font-semibold leading-none tracking-tight">3.2×</p><p class="mt-[2px] text-[3.5px] text-black/70">Net revenue retention</p></div>
                            <div class="grid grid-cols-3 gap-[3px] border-t-[0.5px] border-black/25 pt-[2px]">{[['$4.1M', 'ARR'], ['118', 'Clients'], ['9 mo', 'Payback']].map(([n, l]) => <span><span class="block text-[4px] font-semibold leading-none">{n}</span><span class="block text-[2.8px] text-black/60">{l}</span></span>)}</div>
                          </div>
                        )}
                        <p class="font-mono text-[8px] leading-none text-paper/40">{['01 · Title', '07 · Traction', '09 · Metrics'][v]}</p>
                      </div>
                    ))}
                  </div>
                  <!-- Ad set: square ads with photo, headline and CTA -->
                  <div class="rcv-set grid h-full grid-cols-3 gap-1.5" data-job="Ad set × 4">
                    {['/placeholder/rcv-ad-1.webp', '/placeholder/rcv-ad-2.webp', '/placeholder/rcv-ad-3.webp'].map((src, v) => (
                      <div class="rcv-thumb relative overflow-hidden rounded-md" style={`transition-delay:${v * 150}ms`}>
                        <img src={url(src)} srcset={srcset(src)} sizes="160px" alt="" loading="lazy" class="absolute inset-0 size-full object-cover" />
                      </div>
                    ))}
                  </div>
                </div>
                <p class="rcv-meta label mt-3 text-paper/40">Designing…</p>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>

    <!-- The board: cards move Requested → In progress → Review → Done on a loop -->
    <div class="mt-5 rounded-[28px] bg-white/[0.04] p-2" data-reveal>
      <div class="flex items-center gap-1.5 px-4 py-3" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span>
        <span class="label ml-3 text-paper/35">Your request board</span>
      </div>
      <div class="overflow-x-auto rounded-[22px] bg-black p-4 sm:p-6">
        <div class="board grid min-w-[760px] grid-cols-4 gap-4" data-tags={JSON.stringify(tagColor)}>
          {board.map((c) => (
            <div>
              <p class="label flex items-center justify-between text-paper/45">{c.col}<span class="col-count">{c.cards.length}</span></p>
              <ul class="col-cards mt-3 space-y-2" data-col={c.col}>
                {c.cards.map((card: { t: string; tag: string }) => (
                  <li class="card rounded-xl bg-white/[0.06] p-3 text-[14px]">
                    <p class="card-t">{card.t}</p>
                    <div class="mt-2 flex items-center justify-between">
                      <span class:list={['card-tag rounded-full px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.1em]', tagColor[card.tag] ?? 'bg-white/10 text-paper/60']}>{card.tag}</span>
                      <span class="card-due label text-paper/40">Due Wed</span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
    <p class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-3 text-center text-[15px] text-paper/50">
      <span>Brief it however you like: a doc, a Figma link, a wireframe or a two-minute Loom. <span class="text-paper/80">Have any questions?</span></span>
      <a href={url('/#book')} class="btn-ghost h-14 w-full px-10 text-[16px] sm:w-auto sm:min-w-[260px]">Book a free consultation</a>
    </p>

  </div>
</section>

<style is:global>
  /* Divider ticker: fade the text in/out at the block edges. */
  .ticker { mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  /* Subscribe: cursor travels to the button, button confirms, board-ready row appears. */
  .anim-sub .sub-cursor { left: 85%; top: 120%; opacity: 0; }
  .anim-sub[data-state='1'] .sub-cursor { left: 70%; top: 40%; opacity: 1; }
  .anim-sub[data-state='2'] .sub-cursor { left: 70%; top: 40%; opacity: 1; transform: scale(0.85); }
  .anim-sub[data-state='2'] .sub-btn { transform: scale(0.97); filter: brightness(0.92); }
  .anim-sub[data-state='3'] .sub-btn { background: var(--color-paper); }
  .anim-sub[data-state='3'] .sub-cursor { left: 95%; top: 120%; opacity: 0; }
  .anim-sub .sub-ready { opacity: 0; transform: translateY(8px); }
  .anim-sub[data-state='3'] .sub-ready { opacity: 1; transform: none; }

  /* Request: new cards slide in at the top. */
  .req-enter { animation: req-in 0.5s cubic-bezier(.2,.7,.2,1); }
  @keyframes req-in { from { opacity: 0; transform: translateY(-10px) scale(0.98); } to { opacity: 1; transform: none; } }

  /* Board: the column decides how a card looks. */
  .board .card-due { display: none; }
  .board [data-col='In progress'] .card-due { display: inline; }
  .board [data-col='Done'] .card { color: color-mix(in srgb, var(--color-paper) 50%, transparent); }
  .board [data-col='Done'] .card-t { text-decoration: line-through; text-decoration-color: rgb(255 255 255 / .2); }

  /* Receive: thumbnails pop in once the bar completes. */
  [data-anim='receive'] .rcv-set { position: absolute; inset: 0; visibility: hidden; }
  [data-anim='receive'] .rcv-set.on { visibility: visible; }
  [data-anim='receive'] .rcv-thumb { opacity: 0; transform: scale(0.9); transition: opacity .5s, transform .5s; }
  [data-anim='receive'][data-state='done'] .rcv-thumb { opacity: 1; transform: none; }
  [data-anim='receive'][data-state='out'] .rcv-thumb { transition-duration: .3s; transition-delay: 0s !important; }
  [data-anim='receive'][data-state='done'] .rcv-icon { background: var(--color-spark); color: var(--color-ink); border-color: transparent; }

  @media (prefers-reduced-motion: reduce) {
    .anim-sub .sub-cursor { display: none; }
    .anim-sub .sub-ready, [data-anim='receive'] .rcv-thumb { opacity: 1; transform: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  // Run a looping animation only while it's on screen.
  function whenVisible(el: Element, loop: (alive: () => boolean) => Promise<void>) {
    let visible = false;
    let running = false;
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !running) {
        running = true;
        (async () => {
          while (visible) await loop(() => visible);
          running = false;
        })();
      }
    }).observe(el);
  }

  // 01 Subscribe
  const sub = document.querySelector<HTMLElement>('[data-anim="subscribe"]');
  if (sub) {
    const label = sub.querySelector('.sub-label')!;
    const arrow = sub.querySelector('.sub-arrow')!;
    const set = (state: string, text: string, icon: string) => {
      sub.dataset.state = state;
      label.textContent = text;
      arrow.textContent = icon;
    };
    if (reduce) set('3', '✓ You’re in', '');
    else
      whenVisible(sub, async () => {
        set('0', 'Start today', '→'); await sleep(900);
        set('1', 'Start today', '→'); await sleep(800);
        set('2', 'Processing…', '◌'); await sleep(1100);
        set('3', '✓ You’re in', ''); await sleep(2600);
      });
  }

  // 02 Request
  const req = document.querySelector<HTMLElement>('[data-anim="request"]');
  if (req && !reduce) {
    const list = req.querySelector('.req-list')!;
    const count = req.querySelector('.req-count')!;
    const pool = ['Logo refresh', 'Email template', 'Ad set × 4', 'Onboarding flow', 'Pitch one-pager', 'Landing page hero', 'Dashboard UI', 'Brand guide'];
    let n = 3;
    let k = 0;
    const statusCls = 'req-status shrink-0 rounded-full px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.08em]';
    whenVisible(req, async () => {
      await sleep(1800);
      // the in-progress item is delivered, the next one starts
      const items = list.querySelectorAll('.req');
      items[0]?.remove();
      const next = list.querySelector('.req-status');
      if (next) { next.className = statusCls + ' bg-spark/15 text-spark'; next.textContent = 'In progress'; }
      // a new request lands at the bottom of the queue
      const li = document.createElement('li');
      li.className = 'req req-enter flex items-center justify-between gap-2 rounded-xl bg-white/[0.05] h-10 px-3';
      li.innerHTML = `<span class="truncate">${pool[k++ % pool.length]}</span><span class="${statusCls} bg-white text-ink">New</span>`;
      list.appendChild(li);
      setTimeout(() => { const s = li.querySelector('.req-status'); if (s && s.textContent === 'New') { s.className = statusCls + ' bg-white/10 text-paper/50'; s.textContent = 'Queued'; } }, 1200);
      count.textContent = String(++n);
    });
  }

  // Board: every few seconds each column hands its top card to the next one.
  const boardEl = document.querySelector<HTMLElement>('.board');
  if (boardEl && !reduce) {
    const cols = [...boardEl.querySelectorAll<HTMLElement>('.col-cards')];
    const counts = [...boardEl.querySelectorAll('.col-count')];
    const tags: Record<string, string> = JSON.parse(boardEl.dataset.tags || '{}');
    const fresh = [['Dashboard UI', 'Product'], ['Logo refresh', 'Brand'], ['Email template', 'Email'], ['Ad set × 4', 'Ads'], ['Pitch one-pager', 'Deck'], ['Landing page hero', 'Web'], ['Instagram set × 6', 'Social']];
    const template = boardEl.querySelector('.card')!.cloneNode(true) as HTMLElement;
    let f = 0;
    const ease = 'cubic-bezier(.2,.7,.2,1)';
    whenVisible(boardEl, async () => {
      await sleep(2600);
      // Done's oldest card fades out first
      const old = cols[3].lastElementChild as HTMLElement | null;
      if (old) { old.animate([{ opacity: 1 }, { opacity: 0, transform: 'scale(.96)' }], { duration: 300, easing: ease, fill: 'forwards' }); await sleep(300); old.remove(); }
      // FLIP: measure, move every column's top card one column right, then slide from the old spot
      const cards = [...boardEl.querySelectorAll<HTMLElement>('.card')];
      const before = new Map(cards.map((c) => [c, c.getBoundingClientRect()]));
      for (let i = 2; i >= 0; i--) {
        const card = cols[i].firstElementChild;
        if (card) cols[i + 1].prepend(card);
      }
      // a new request lands at the bottom of Requested
      const [t, tag] = fresh[f++ % fresh.length];
      const li = template.cloneNode(true) as HTMLElement;
      li.querySelector('.card-t')!.textContent = t;
      const chip = li.querySelector('.card-tag')!;
      chip.className = 'card-tag rounded-full px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.1em] ' + (tags[tag] ?? 'bg-white/10 text-paper/60');
      chip.textContent = tag;
      cols[0].appendChild(li);
      cols.forEach((c, i) => (counts[i].textContent = String(c.children.length)));
      cards.forEach((c) => {
        const a = before.get(c)!, b = c.getBoundingClientRect();
        const dx = a.left - b.left, dy = a.top - b.top;
        if (dx || dy) c.animate([{ transform: `translate(${dx}px,${dy}px)` }, { transform: 'none' }], { duration: 700, easing: ease });
      });
      li.animate([{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'none' }], { duration: 500, delay: 350, easing: ease, fill: 'backwards' });
    });
  }

  // 03 Receive
  const rcv = document.querySelector<HTMLElement>('[data-anim="receive"]');
  if (rcv) {
    const bar = rcv.querySelector<HTMLElement>('.rcv-bar')!;
    const pct = rcv.querySelector('.rcv-pct')!;
    const meta = rcv.querySelector('.rcv-meta')!;
    const title = rcv.querySelector('.rcv-title')!;
    const jobs = ['Onboarding flow', 'Pitch deck v2', 'Ad set × 4', 'Pricing page'];
    const sets = rcv.querySelectorAll<HTMLElement>('.rcv-set');
    const show = (job: string) => sets.forEach((x) => x.classList.toggle('on', x.dataset.job === job));
    let j = 0;
    const done = () => { rcv.dataset.state = 'done'; bar.style.width = '100%'; pct.textContent = '100%'; meta.textContent = 'Delivered · 1d 22h'; };
    if (reduce) { show(jobs[0]); title.textContent = jobs[0]; done(); }
    else
      whenVisible(rcv, async () => {
        rcv.dataset.state = '0';
        const job = jobs[j++ % jobs.length];
        title.textContent = job;
        show(job);
        meta.textContent = 'Designing…';
        for (let p = 0; p <= 100; p += 4) { bar.style.width = p + '%'; pct.textContent = p + '%'; await sleep(55); }
        done();
        await sleep(2800);
        // fade this job's thumbnails out, then swap sets while they're invisible
        rcv.dataset.state = 'out';
        await sleep(350);
      });
  }
</script>
