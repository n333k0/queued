---
import { url } from '../lib/url';
import { srcset } from '../lib/img';
import { scope, scopeMore } from '../data/site';
---

<section id="scope" class="bg-paper py-12 text-ink sm:py-16">
  <div class="wrap">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="label text-pine-500">What we design</p>
        <h2 class="display mt-4 t-h2">Apps, websites, brands <span class="accent">& more.</span></h2>
      </div>
      <p class="max-w-sm text-[16px] text-ink/60">Everything a growing company needs, under one subscription. If it’s on a screen or a slide, put it in the queue.</p>
    </div>

    <div class="mt-14 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {scope.map((s, i) => (
        <article class:list={['group relative overflow-hidden rounded-[22px] bg-ink', i === 0 ? 'col-span-2 row-span-2 aspect-square lg:aspect-auto' : 'aspect-[4/5]']} data-reveal>
          <img src={url(s.img)} srcset={srcset(s.img)} sizes={i === 0 ? "(min-width: 1024px) 50vw, 100vw" : "(min-width: 1024px) 25vw, 50vw"} alt="" loading="lazy" class="absolute inset-0 size-full object-cover transition duration-700 group-hover:scale-[1.04]" />
          <h3 class="absolute bottom-4 left-4 right-4 w-fit rounded-full bg-pine-950 px-4 py-2 text-[14px] font-medium tracking-tight text-paper sm:text-[15px]">{s.title}</h3>
        </article>
      ))}
      <article class="col-span-2 flex min-h-[200px] flex-col justify-between gap-6 rounded-[22px] bg-ink p-6 text-paper" data-reveal>
        <div>
          <p class="label text-spark">And more</p>
          <p class="mt-3 max-w-sm text-[22px] font-medium leading-tight tracking-tight">If it’s on a screen or a slide, it’s in scope.</p>
        </div>
        <ul class="flex flex-wrap gap-1.5">
          {scopeMore.map((m) => <li class="rounded-full bg-white/[0.08] px-3 py-1.5 text-[13px] text-paper/80">{m}</li>)}
        </ul>
      </article>
    </div>
  </div>
</section>
