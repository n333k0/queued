---
import { compare, compareHeads } from '../data/site';
---

<section class="py-24 sm:py-32">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="label text-spark">Why a subscription</p>
      <h2 class="display mt-4 t-h2">A senior design team, <span class="accent text-spark">minus the payroll.</span></h2>
      <p class="mt-6 max-w-xl text-[18px] text-paper/65">Hiring takes months. Agencies take weeks. Freelancers take a chance. A membership takes about a minute.</p>
    </div>

    <!-- Phone: queued. vs one alternative at a time, picked with the switcher -->
    <div class="cmp mt-10 sm:hidden" data-a="0" data-reveal>
      <div class="flex gap-1 rounded-full bg-white/[0.05] p-1" role="tablist" aria-label="Compare queued. with">
        {compareHeads.map((h, i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i} class="cmp-tab flex-1 rounded-full px-2 py-2.5 text-[12px] font-medium leading-tight text-paper/55 transition-colors">{h}</button>
        ))}
      </div>
      <div class="mt-3 grid grid-cols-2 overflow-hidden rounded-[22px] bg-white/[0.04] text-[14px]">
        <p class="label flex items-center px-4 py-3.5 text-paper/45">{compareHeads.map((h, i) => <span data-c={i}>{h}</span>)}</p>
        <p class="bg-spark px-4 py-3 text-[17px] font-semibold tracking-tight text-ink">queued.</p>
        {compare.map((r) => (
          <>
            <p class="col-span-2 border-t border-white/[0.06] px-4 pt-3 font-mono text-[10px] uppercase tracking-[0.14em] text-paper/40">{r.label}</p>
            <p class="px-4 pb-3.5 pt-1.5 text-paper/50">{r.values.slice(0, 3).map((v, i) => <span data-c={i}>{v}</span>)}</p>
            <p class="px-4 pb-3.5 pt-1.5 font-medium">{r.values[3]}</p>
          </>
        ))}
      </div>
    </div>

    <div class="mt-14 hidden overflow-x-auto rounded-[28px] bg-white/[0.04] sm:block" data-reveal>
      <table class="w-full min-w-[760px] text-left text-[15px]">
        <thead>
          <tr class="border-b border-white/[0.06]">
            <th class="py-5 pl-7 pr-5 sm:pl-9" scope="col"><span class="sr-only">Compare</span></th>
            {compareHeads.map((h) => <th scope="col" class="label p-5 font-normal text-paper/45">{h}</th>)}
            <th scope="col" class="bg-spark p-5 text-[18px] font-semibold tracking-tight text-ink">queued.</th>
          </tr>
        </thead>
        <tbody>
          {compare.map((r) => (
            <tr class="border-b border-white/[0.06] last:border-0">
              <th scope="row" class="py-5 pl-7 pr-5 font-normal text-paper/60 sm:pl-9">{r.label}</th>
              {r.values.slice(0, 3).map((v) => <td class="p-5 text-paper/45">{v}</td>)}
              <td class="bg-white/[0.06] p-5 font-medium">{r.values[3]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .cmp [data-c] { display: none; }
  .cmp[data-a='0'] [data-c='0'], .cmp[data-a='1'] [data-c='1'], .cmp[data-a='2'] [data-c='2'] { display: inline; }
  .cmp-tab[aria-selected='true'] { background: var(--color-paper); color: var(--color-ink); }
</style>

<script>
  // Phone compare switcher: pick which alternative sits next to queued.
  document.querySelectorAll<HTMLElement>('.cmp').forEach((box) => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('.cmp-tab')];
    tabs.forEach((t) => t.addEventListener('click', () => {
      box.dataset.a = t.dataset.i;
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
    }));
  });
</script>
